{
  "name": "painless",
  "version": "0.0.0",
  "description": "A lightweight React SPA template — zero SSR, zero-runtime CSS, type-safe",
  "private": true,
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "commit": "lint-staged && git-cz -n",
    "coverage": "vitest run --coverage",
    "lint": "eslint --fix .",
    "lint:ci": "eslint .",
    "deploy": "cross-env BABEL_ENV=development BUILD_DEMO=true vite build && gh-pages -d dist",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "react",
    "framework",
    "frontend",
    "vite",
    "typescript"
  ],
  "author": "wmzy",
  "license": "ISC",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@babel/register": "^8.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.4.0",
    "@types/ramda": "^0.32.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@wyw-in-js/vite": "^2.4.3",
    "babel-plugin-transform-jsx-class": "^0.1.3",
    "babel-plugin-transform-jsx-condition": "^0.1.3",
    "babel-runtime-jsx-plus": "^0.1.5",
    "commitizen": "^4.3.2",
    "core-js": "^3.50.0",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "eslint": "^10.9.1",
    "eslint-plugin-compat": "^7.0.2",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "json-schema-faker": "^0.6.3",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ramda": "^0.32.0",
    "rollup-plugin-type-as-json-schema": "^0.2.6",
    "terser": "^5.51.0",
    "tools-config": "^0.3.0",
    "tsc-alias": "^1.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@for-fun/event-emitter": "^1.0.1",
    "@linaria/core": "^8.2.0",
    "@native-router/core": "^1.8.0",
    "@native-router/react": "^1.6.2",
    "fetch-fun": "^0.10.0",
    "haze-ui": "^1.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-f0rm": "^0.6.0",
    "react-toolroom": "^0.12.4",
    "react-use-control": "^1.3.2"
  }
}
